# 복사해서 .env 로 저장 후 값 변경 (절대 커밋하지 말 것)
# openssl rand -hex 32 로 생성
JWT_SECRET=change-me-jwt-secret
PIN_SECRET=change-me-pin-secret

# 토큰 수명
ACCESS_TOKEN_TTL=1h
# 테스트 모드(탭 로그인)의 액세스 토큰 수명. 재발급이 없어 더 길게
TAB_ACCESS_TOKEN_TTL=3h
REFRESH_TOKEN_TTL_HOURS=12

# refresh 쿠키 Secure 플래그. 미설정 시 NODE_ENV=production 이면 true, 아니면 false.
# 운영(https 뒤)에서 강제로 끄거나 로컬에서 켜야 할 때만 지정
# COOKIE_SECURE=true

# 서버 설정 (컨테이너에서는 Dockerfile/compose 가 PORT, DB_PATH 를 주입하므로 비워둔다)
# 로컬 npm run dev 기본값: PORT=3000, DB_PATH=./data/csd.sqlite
# PORT=3000
# DB_PATH=/app/data/csd.sqlite
SEED_ON_START=true
